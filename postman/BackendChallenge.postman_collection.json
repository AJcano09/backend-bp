    {
      "name": "Clientes",
      "description": "CRUD del microservicio de clientes (F1). Los POST de creación guardan el clienteId devuelto en variables de colección que usan las carpetas siguientes.",
      "item": [
        {
          "name": "POST Crear cliente - Jose Lema",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// 201 en primera ejecución: guarda el id devuelto. 409 en re-ejecución: el cliente ya existe y se recupera su id desde la lista, así el encadenamiento sigue funcionando sin base vacía.",
                  "pm.test(\"Status 201 (creado) o 409 (ya existía)\", () => pm.expect(pm.response.code).to.be.oneOf([201, 409]));",
                  "if (pm.response.code === 201) {",
                  "  const body = pm.response.json();",
                  "  pm.test(\"Devuelve clienteId numérico\", () => pm.expect(body.clienteId).to.be.a('number'));",
                  "  pm.test(\"Estado activo\", () => pm.expect(body.estado).to.eql(true));",
                  "  pm.collectionVariables.set(\"clienteIdJoseLema\", body.clienteId);",
                  "} else {",
                  "  pm.sendRequest(\"{{clientServiceUrl}}/api/clientes\", (e, res) => {",
                  "    const found = res.json().find(c => c.identificacion === \"1723456789\");",
                  "    if (found) {",
                  "      pm.collectionVariables.set(\"clienteIdJoseLema\", found.clienteId);",
                  "      console.log(\"Cliente ya existente; id recuperado de la lista: \" + found.clienteId);",
                  "    }",
                  "  });",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Jose Lema\",\n  \"genero\": \"Masculino\",\n  \"edad\": 35,\n  \"identificacion\": \"1723456789\",\n  \"direccion\": \"Otavalo sn y principal\",\n  \"telefono\": \"098254785\",\n  \"contrasena\": \"1234\",\n  \"estado\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{clientServiceUrl}}/api/clientes",
              "host": [
                "{{clientServiceUrl}}"
              ],
              "path": [
                "api",
                "clientes"
              ]
            },
            "description": "Caso de uso 1 del enunciado. Guarda el clienteId en la variable de colección clienteIdJoseLema."
          },
          "response": []
